#!/usr/bin/env bash
set -euo pipefail

SCRIPT_INVOCATION_NAME="$(basename -- "${BASH_SOURCE[0]}")"
command -v python3 >/dev/null 2>&1 || { echo "symphony: python3 not found in PATH" >&2; exit 127; }
SCRIPT_PATH="$("${SYMPHONY_PYTHON:-python3}" -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)"
if [[ "${BASH_SOURCE[0]}" == "$0" && "${SYMPHONY_SERVICE_OWNER_PID:-}" != "$$" ]]; then
  exec "${SYMPHONY_PYTHON:-python3}" "$SCRIPT_DIR/scripts/service-lock.py" run /bin/bash "${BASH_SOURCE[0]}" "$@"
fi
PROJECT_DIR="$SCRIPT_DIR"
MIX_RUNTIME_PATH="$PROJECT_DIR/scripts/mix-runtime"

if [ ! -x "$MIX_RUNTIME_PATH" ]; then
  echo "symphony: Mix-Preflight fehlt oder ist nicht ausführbar: $MIX_RUNTIME_PATH" >&2
  exit 1
fi
source "$MIX_RUNTIME_PATH"

symphony_launch() {
  shift
  mix_runtime_activate "$PROJECT_DIR"
  export SYMPHONY_ROOT_DIR="$PROJECT_DIR"
  export SYMPHONY_WORKFLOW_FILE="$PROJECT_DIR/WORKFLOW.md"
  export SYMPHONY_WORKFLOW_INTERACTIVE_FILE="$PROJECT_DIR/WORKFLOW_INTERACTIVE.md"
  export SYMPHONY_WORKFLOW_DIALOG_FILE="$PROJECT_DIR/WORKFLOW_DIALOG.md"
  export SYMPHONY_WORKFLOW_DIR="$PROJECT_DIR"
  unset SYMPHONY_RELEASE_ROOT
  exec "$PROJECT_DIR/bin/symphony" "$@"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  mix_runtime_activate "$PROJECT_DIR"
  export SYMPHONY_ROOT_DIR="$PROJECT_DIR"
  unset SYMPHONY_RELEASE_ROOT SYMPHONY_PROJECT_CONTEXT SYMPHONY_LINEAR_AUTH_MODE SYMPHONY_LINEAR_BINDING_HASH
  exec "$MIX_RUNTIME_PATH" start "$PROJECT_DIR" "$SCRIPT_INVOCATION_NAME" "$@"
fi
