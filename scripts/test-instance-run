#!/usr/bin/env python3
"""Operator entrypoint for the bounded Symphony dummy-project bootstrap proof."""
import argparse
import importlib.util
import json
import os
from pathlib import Path
import signal
import subprocess
import sys
import time
import urllib.error
import urllib.request


def module(name):
    spec = importlib.util.spec_from_file_location(name.replace("-", "_"), Path(__file__).with_name(name + ".py"))
    loaded = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(loaded)
    return loaded


class RunFailure(Exception):
    pass


def atomic(path, value):
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    temporary = path.with_suffix(".tmp")
    descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(descriptor, "w") as stream:
        json.dump(value, stream, sort_keys=True, indent=2)
        stream.flush()
        os.fsync(stream.fileno())
    temporary.replace(path)
    descriptor = os.open(path.parent, os.O_RDONLY)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def parser():
    result = argparse.ArgumentParser(description=__doc__)
    result.add_argument("--checkout", type=Path, required=True)
    result.add_argument("--test-instance", required=True)
    result.add_argument("--manifest", type=Path, required=True)
    result.add_argument("--run-id", required=True)
    result.add_argument("--expected-sha", required=True)
    result.add_argument("--expected-source", required=True)
    result.add_argument("--port", type=int, required=True)
    result.add_argument("--result-dir", type=Path, required=True)
    result.add_argument("--scenario", choices=("bootstrap", "failure-probe", "delegation", "po_incoming", "po_handoff", "po_aggregation", "po_followup"), default="bootstrap")
    result.add_argument("--yolo", action="store_true", help="Folgeticket-Zuweisungsmatrix im isolierten Testlauf")
    result.add_argument("--openclaw-agent", help="Ausdrücklicher Live-Opt-in für genau diesen OpenClaw-Agenten; nur PO-Szenarien")
    result.add_argument("--openclaw-knowledge-question", help="Nichtgeheime Wissensfrage für den Review-Live-Nachweis; Antwort wird vom Betreiber geprüft")
    result.add_argument("--source-mode", choices=("development", "merged"), default="development")
    result.add_argument("--timeout", type=float, default=180)
    result.add_argument("--resume", action="store_true")
    result.add_argument("--cleanup-only", action="store_true", help="Nur eigenes Journal aufräumen; verlangt --resume")
    result.add_argument("--cleanup-plan-sha256", help="Cleanup mit korrigiertem Build; SHA256 des unveränderten ursprünglichen plan.json")
    return result


class Run:
    def __init__(self, args):
        self.args = args
        self.test = module("test-instance")
        self.processes = module("test-processes")
        self.children = []
        self.known = {}
        self.service = None
        self.result = {"evidence": "live", "run_id": args.run_id, "scenario": args.scenario, "status": "failed", "scenarios": {}, "cleanup": False}
        self.result_path = args.result_dir / "result.json"
        self.plan_path = args.result_dir / "plan.json"
        self.deadline = time.monotonic() + args.timeout
        self.result["timeout_seconds"] = args.timeout
        self.result["started_at"] = time.time()
        self.env = dict(os.environ, SYMPHONY_TEST_MANIFEST=str(args.manifest),
                        SYMPHONY_TEST_EXPECTED_SHA=args.expected_sha, SYMPHONY_TEST_EXPECTED_SOURCE=args.expected_source,
                        SYMPHONY_TEST_RUN_PLAN=str(self.plan_path),
                        SYMPHONY_ROOT_DIR=str(args.checkout), SYMPHONY_WORKFLOW_FILE=str(args.checkout / "WORKFLOW.md"),
                        MISE_TRUSTED_CONFIG_PATHS=str(args.checkout / "mise.toml"))
        for key in ("SYMPHONY_PROJECT_CONTEXT", "SYMPHONY_LINEAR_AUTH_MODE", "SYMPHONY_LINEAR_BINDING_HASH"):
            self.env.pop(key, None)
        self.env.pop("SYMPHONY_TEST_CLEANUP_PLAN_SHA256", None)
        if not getattr(args, "openclaw_agent", None):
            self.env["SYMPHONY_OPENCLAW_TEST_DENY"] = "1"
        if args.cleanup_plan_sha256:
            self.env["SYMPHONY_TEST_CLEANUP_PLAN_SHA256"] = args.cleanup_plan_sha256

    def save(self):
        atomic(self.result_path, self.result)

    def verify_openclaw(self, fixtures):
        receipts = [f.get("po_receipt", f.get("handoff_receipt", {}))
                    for f in fixtures if f.get("po_incoming") or f.get("po_handoff")]
        proofs = [r.get("openclaw", {}) for r in receipts]
        if not proofs or not all(p.get("agent") == self.args.openclaw_agent and
                                 p.get("state") == "completed" and p.get("payload_sha256") and
                                 p.get("session_id") == r.get("session_id")
                                 for p, r in zip(proofs, receipts)):
            raise RunFailure("openclaw_execution_unconfirmed")
        self.result["openclaw"] = {"agent": self.args.openclaw_agent, "executions": proofs,
                                  "knowledge_and_instruction_review": "operator_evidence_required"}

    def remaining(self):
        value = self.deadline - time.monotonic()
        if value <= 0:
            raise RunFailure("timeout")
        return value

    def start(self, stage, direct=False):
        env = dict(self.env, SYMPHONY_TEST_RUN_STAGE=stage)
        flags = ["--test-instance", self.args.test_instance, "--port", str(self.args.port)]
        if self.args.yolo:
            flags.append("--yolo")
        command = (["mise", "exec", "--", str(self.args.checkout / "bin/symphony")] if direct else [str(self.args.checkout / "symphony")]) + flags
        # The parent owns the fixture reservation through build, run and cleanup.
        # All child entrypoints still validate the explicit test mode and source.
        trampoline = "import os,sys; os.environ['SYMPHONY_SERVICE_OWNER_PID']=str(os.getpid()); os.execvpe(sys.argv[1],sys.argv[1:],os.environ)"
        output = subprocess.PIPE
        if stage == "run":
            output = os.fdopen(os.open(self.args.result_dir / "service.log", os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600), "ab")
        try:
            child = subprocess.Popen([sys.executable, "-c", trampoline, *command], cwd=self.args.checkout,
                                     env=env, start_new_session=True, stdin=subprocess.DEVNULL,
                                     stdout=output, stderr=subprocess.STDOUT)
        finally:
            if stage == "run":
                output.close()
        self.children.append(child)
        return child

    def invoke(self, stage, timeout=None):
        if timeout is None:
            self.remaining()
        child = self.start(stage, direct=stage in ("probe", "cleanup", "delegate", "withdraw"))
        try:
            output, _ = child.communicate(timeout=timeout if timeout is not None else self.remaining())
        except subprocess.TimeoutExpired as error:
            raise RunFailure(stage + "_timeout") from error
        # Preserve local process evidence; provider contents never enter result.json.
        log = self.args.result_dir / (stage + ".log")
        with os.fdopen(os.open(log, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600), "ab") as stream:
            stream.write(output)
        if child.returncode:
            # Only the runtime's small allowlisted diagnostic reaches the public receipt.
            for line in output.splitlines():
                if line.startswith(b"Test run failure="):
                    try:
                        detail = json.loads(line[len(b"Test run failure="):])
                        self.result["runtime_failure"] = {key: detail[key] for key in ("code", "status", "state", "states") if key in detail}
                    except (ValueError, TypeError):
                        pass
            raise RunFailure(stage + "_failed")
        lines = [line[len(b"Test run result="):] for line in output.splitlines() if line.startswith(b"Test run result=")]
        if len(lines) != 1:
            raise RunFailure(stage + "_missing_receipt")
        return json.loads(lines[0])

    def probe(self):
        # Only this observation stage is read-only in Linear. Keep the same
        # service, fixtures and deadline; never replay preparation or mutations.
        while self.remaining():
            if self.service.poll() is not None:
                raise RunFailure("service_exited")
            self.result.pop("runtime_failure", None)
            try:
                return self.invoke("probe")
            except RunFailure as error:
                failure = self.result.get("runtime_failure")
                retries = self.result.get("probe_retries", [])
                if (str(error) != "probe_failed" or
                        failure not in ({"code": "linear_app_request_unavailable"},
                                        {"code": "linear_http", "status": 503}) or len(retries) >= 2):
                    raise
                delay = (2, 5)[len(retries)]
                if self.remaining() <= delay:
                    raise RunFailure("timeout") from error
                retries.append(dict(attempt=len(retries) + 2, delay_seconds=delay, failure=failure))
                self.result["probe_retries"] = retries
                self.save()
                time.sleep(delay)

    def stop_children(self):
        self.processes.descendants(os.getpid(), self.known, {int(os.environ.get("SYMPHONY_SERVICE_GUARD_PID", "0"))})
        for child in self.children:
            if child.poll() is None:
                try:
                    os.killpg(child.pid, signal.SIGTERM)
                except ProcessLookupError:
                    pass
        for child in self.children:
            try:
                child.communicate(timeout=5)
            except subprocess.TimeoutExpired:
                os.killpg(child.pid, signal.SIGKILL)
                child.communicate(timeout=5)
        self.processes.cleanup(os.getpid(), self.known, {int(os.environ.get("SYMPHONY_SERVICE_GUARD_PID", "0"))})
        self.children = []
        self.known = {}

    def state(self):
        try:
            with urllib.request.urlopen(f"http://127.0.0.1:{self.args.port}/api/v1/state", timeout=min(2, self.remaining())) as response:
                return json.load(response)
        except (OSError, ValueError, urllib.error.URLError):
            return {}

    def ready(self, state, capsule):
        service = state.get("service", {})
        expected = capsule["manifest"]["projects"]
        actual = service.get("bindings", [])
        return (str(service.get("pid")) == str(self.service.pid) and service.get("source") == capsule["source"]
                and service.get("test_instance") == self.args.test_instance
                and bool(expected) and len(actual) == len(expected)
                and {entry["name"] for entry in actual} == expected.keys()
                and all(entry.get("project_id") == expected[entry["name"]]["project_id"]
                        and entry.get("workspace_id") == expected[entry["name"]]["workspace_id"] for entry in actual)
                and all(state.get("relay", {}).get(binding["workspace_id"], {}).get("status") == "ready" for binding in expected.values()))

    def fixture_ids(self, fixtures, projects, scenario="bootstrap"):
        states = ["Todo (AI)"] + {
            "po_incoming": ["Backlog", "Todo", "Definiert"],
            "po_aggregation": ["Backlog", "Todo", "Definiert"],
            "po_handoff": ["BLOCKER", "Review"],
            "po_followup": ["Review"],
        }.get(scenario, [])
        expected = {(project, state) for project in projects for state in states}
        if (not isinstance(fixtures, list) or not projects or len(fixtures) != len(expected)
                or any(not isinstance(f, dict) or not isinstance(f.get("id"), str) or not f["id"]
                       or f.get("created") is not True or f.get("deleted") is not False for f in fixtures)
                or {(f.get("project"), f.get("initial_state", "Todo (AI)")) for f in fixtures} != expected
                or len({f["id"] for f in fixtures}) != len(fixtures)):
            raise RunFailure("invalid_fixture_mapping")
        return {f["id"]: (f["project"], f.get("initial_state", "Todo (AI)")) for f in fixtures}

    def collect_sessions(self, running, fixtures, sessions, shared=frozenset()):
        seen = set()
        for entry in running:
            issue = entry.get("issue_id")
            if issue not in fixtures or issue in seen:
                raise RunFailure("invalid_session_mapping")
            seen.add(issue)
            session = entry.get("session_id")
            if session:
                if not isinstance(session, str) or not session.strip():
                    raise RunFailure("invalid_session_mapping")
                sessions[issue] = session
        for session in set(sessions.values()):
            members = {issue for issue, value in sessions.items() if value == session}
            if len(members) > 1 and not members <= shared:
                raise RunFailure("invalid_session_mapping")

    def competition(self):
        env = dict(self.env)
        for key in ("SYMPHONY_SERVICE_OWNER_PID", "SYMPHONY_SERVICE_GUARD_PID", "SYMPHONY_SERVICE_LOCK_MODE"):
            env.pop(key, None)
        launcher = str(self.args.checkout / "symphony")
        ticket = self.args.result_dir / "symphony-PRO-736"
        if ticket.exists() or ticket.is_symlink():
            if not ticket.is_symlink() or ticket.resolve() != Path(launcher):
                raise RunFailure("foreign_ticket_launcher")
        else:
            ticket.symlink_to(launcher)
        commands = [[launcher], [launcher, "--test-instance", "contention"],
                    [str(ticket), "--test-instance", "contention"],
                    ["mise", "exec", "--", str(self.args.checkout / "bin/symphony"), "--test-instance", "contention"]]
        for command in commands:
            result = subprocess.run(command, cwd=self.args.checkout, env=env, stdin=subprocess.DEVNULL,
                                    stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=min(15, self.remaining()))
            if result.returncode == 0 or b"Symphony l\xc3\xa4uft bereits" not in result.stdout:
                raise RunFailure("concurrent_start_not_rejected")
        self.result["scenarios"]["exclusive_access"] = {"passed": True, "entrypoints": ["normal", "test", "ticket", "escript"]}

    def fetch(self):
        child = subprocess.Popen(["git", "-C", str(self.args.checkout), "fetch", "origin"],
                                 env=dict(self.env, GIT_TERMINAL_PROMPT="0"), start_new_session=True,
                                 stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
        self.children.append(child)
        try:
            child.communicate(timeout=self.remaining())
        except subprocess.TimeoutExpired as error:
            # Keep the leader alive until stop_children inventories and reaps
            # its entire process group, including a stalled SSH transport.
            raise RunFailure("fetch_timeout") from error
        if child.returncode:
            raise RunFailure("fetch_failed")

    def fixture_journal_path(self):
        return Path.home().resolve() / ".local/state/symphony/test-environment/runs" / self.args.run_id / "fixtures.json"

    def confirm_no_fixture_intent(self):
        # TestRun persists this journal before any fixture mutation. Only check
        # while holding the environment reservation and after reaping children.
        # Existing, corrupt, aliased or unreadable journals still require the
        # original runtime's reconciliation; plan.json alone is not an intent.
        try:
            self.test.canonical(self.fixture_journal_path()).lstat()
        except FileNotFoundError:
            self.result.update(cleanup=True, fixtures=[], cleanup_scope="no_fixture_intent")
            return True
        except (OSError, ValueError):
            pass
        return False

    def execute(self):
        prepared = False
        originals = {}
        capsule = None
        # Archive before any fallible preflight. If archival itself fails, do
        # not enter the finally block that writes the next result.json.
        if self.args.resume and self.result_path.exists():
            previous = json.loads(self.result_path.read_text())
            originals = previous.get("original_projects", {})
            history = self.args.result_dir / ("result-" + str(time.time_ns()) + ".json")
            atomic(history, previous)
            self.result["original_projects"] = originals
            self.result["probe_retries"] = previous.get("probe_retries", [])
        try:
            if self.args.cleanup_only:
                plan = json.loads(self.plan_path.read_text())
                if self.confirm_no_fixture_intent():
                    self.result.update(source=plan["source"], source_mode=self.args.source_mode)
                    return 1  # No runtime/build is needed when no mutation was attempted.
            self.env["SYM_PROJECT_ROOT"] = json.loads(self.args.manifest.read_text())["project_root"]
            if self.args.cleanup_only:
                self.env["SYMPHONY_TEST_RUN_STAGE"] = "cleanup"
            capsule = self.test.preflight(self.args.test_instance, self.args.checkout, self.env)
            if self.args.source_mode == "merged" and not self.args.cleanup_only:
                self.fetch()
                remote = self.test.git(self.args.checkout, "rev-parse", "origin/main").decode().strip()
                if capsule["source"]["dirty"] or remote != capsule["source"]["sha"]:
                    raise RunFailure("merged_source_mismatch")
            self.result.update(source=capsule["source"], source_mode=self.args.source_mode,
                               projects=capsule["manifest"]["projects"])
            originals = originals or {name: self.test.source(Path(capsule["manifest"]["project_root"]) / name) for name in capsule["manifest"]["projects"]}
            self.result["original_projects"] = originals
            if self.plan_path.exists():
                existing = json.loads(self.plan_path.read_text())
                owner_source = capsule.get("cleanup_recovery", {}).get("source", capsule["source"])
                if not self.args.resume or existing["source"] != owner_source or existing["run_id"] != self.args.run_id or existing.get("scenario", "bootstrap") != self.args.scenario or existing.get("yolo", False) != self.args.yolo or existing.get("openclaw_agent") != getattr(self.args, "openclaw_agent", None):
                    raise RunFailure("run_already_exists_or_changed")
                if existing.get("openclaw_knowledge_question") != getattr(self.args, "openclaw_knowledge_question", None):
                    raise RunFailure("openclaw_knowledge_question_changed")
            else:
                atomic(self.plan_path, {"evidence": "live", "instance": self.args.test_instance,
                                        "run_id": self.args.run_id, "source": capsule["source"], "scenario": self.args.scenario, "yolo": self.args.yolo,
                                        "openclaw_agent": getattr(self.args, "openclaw_agent", None),
                                        "openclaw_knowledge_question": getattr(self.args, "openclaw_knowledge_question", None)})
            self.save()
            prepared = True  # Intent may be durable even when prepare loses its response.
            if self.args.cleanup_only:
                self.result["scenarios"]["cleanup_only"] = True
                if self.args.cleanup_plan_sha256:
                    self.result["cleanup_recovery"] = capsule["cleanup_recovery"]
                return 1  # Cleanup in finally is a recovery receipt, never a test pass.
            fixtures = self.invoke("prepare")["fixtures"]
            self.result["fixtures"] = fixtures
            fixture_ids = self.fixture_ids(fixtures, capsule["manifest"]["projects"], self.args.scenario)
            if self.args.scenario == "failure-probe":
                raise RunFailure("intentional_failure_probe")
            self.competition()
            self.service = self.start("run")
            sessions = {}
            shared = {f["id"] for f in fixtures if f.get("po_incoming")}
            observed_ready = False
            last_probe = 0
            delegated = False
            withdrawn = False
            while self.remaining():
                if self.service.poll() is not None:
                    raise RunFailure("service_exited")
                self.processes.descendants(os.getpid(), self.known, {int(os.environ.get("SYMPHONY_SERVICE_GUARD_PID", "0"))})
                state = self.state()
                if self.ready(state, capsule):
                    observed_ready = True
                    self.result["scenarios"]["readiness"] = {"passed": True, "service": state["service"]}
                    self.result["consumers"] = {key: value["consumer_id"] for key, value in state["relay"].items()}
                    if self.args.scenario == "delegation" and not delegated:
                        self.result["fixtures"] = self.invoke("delegate")["fixtures"]
                        delegated = True
                self.collect_sessions(state.get("running", []), fixture_ids, sessions, shared)
                self.result["sessions"] = sessions
                self.save()
                if observed_ready and (len(sessions) == len(fixtures) or self.args.scenario in ("po_incoming", "po_handoff", "po_aggregation", "po_followup")) and time.monotonic() - last_probe >= 3:
                    probe = self.probe()
                    probed = probe["fixtures"]
                    self.result["derived"] = probe.get("derived", [])
                    last_probe = time.monotonic()
                    if self.fixture_ids(probed, capsule["manifest"]["projects"], self.args.scenario) != fixture_ids:
                        raise RunFailure("changed_fixture_mapping")
                    if all(f["complete"] for f in probed):
                        if getattr(self.args, "openclaw_agent", None):
                            self.verify_openclaw(probed)
                        if self.args.scenario in ("po_aggregation", "po_followup"):
                            derived = probe.get("derived", [])
                            if len(derived) != 1 or derived[0].get("complete") is not True:
                                raise RunFailure("derived_fixture_unconfirmed")
                        if self.args.scenario in ("po_incoming", "po_aggregation"):
                            po = [f for f in probed if f.get("po_incoming")]
                            receipts = [f.get("po_receipt", {}) for f in po]
                            if len(po) != 3 or {f["initial_state"] for f in po} != {"Backlog", "Todo", "Definiert"}:
                                raise RunFailure("po_membership_unconfirmed")
                            if len({r.get("session_id") for r in receipts}) != 1 or not all(r.get("session_id") and r.get("sha") for r in receipts):
                                raise RunFailure("po_shared_session_unconfirmed")
                            for fixture in po:
                                sessions[fixture["id"]] = fixture["po_receipt"]["session_id"]
                            if len(sessions) != len(fixtures):
                                continue
                            self.result["scenarios"][self.args.scenario] = {"passed": True, "fixtures": po}
                            self.result["sessions"] = sessions
                        if self.args.scenario in ("po_handoff", "po_followup"):
                            po = [f for f in probed if f.get("po_handoff")]
                            if {f["initial_state"] for f in po} != ({"BLOCKER", "Review"} if self.args.scenario == "po_handoff" else {"Review"}) or len(po) != (2 if self.args.scenario == "po_handoff" else 1):
                                raise RunFailure("po_handoff_membership_unconfirmed")
                            for fixture in po:
                                receipt = fixture.get("handoff_receipt", {})
                                if not all(receipt.get(key) for key in ("session_id", "sha", "workspace", "report")):
                                    raise RunFailure("po_handoff_receipt_unconfirmed")
                                sessions[fixture["id"]] = receipt["session_id"]
                            if len(sessions) != len(fixtures):
                                continue
                            self.result["scenarios"][self.args.scenario] = {"passed": True, "fixtures": po}
                            self.result["sessions"] = sessions
                        if self.args.scenario in ("po_aggregation", "po_followup"):
                            self.result["scenarios"][self.args.scenario]["derived"] = derived
                        self.result["scenarios"]["bootstrap"] = {"passed": True, "fixtures": [f for f in probed if not f.get("po_incoming") and not f.get("po_handoff")]}
                        if self.args.scenario == "delegation":
                            selected = [f for f in probed if f.get("test_delegate_id")]
                            if len(selected) != 1 or not selected[0].get("delegation_assigned"):
                                raise RunFailure("delegation_assignment_unconfirmed")
                            if not withdrawn:
                                self.result["fixtures"] = self.invoke("withdraw")["fixtures"]
                                withdrawn = True
                                continue
                            if not selected[0].get("delegation_withdrawn"):
                                continue
                            self.result["scenarios"]["delegation"] = {"passed": True, "fixture": selected[0]}
                        if sessions.keys() != fixture_ids.keys():
                            continue
                        self.collect_sessions([], fixture_ids, sessions, shared)
                        consumers = self.result["consumers"]
                        self.stop_children()
                        self.service = self.start("run", direct=True)
                        while self.remaining():
                            if self.service.poll() is not None:
                                raise RunFailure("restart_exited")
                            resumed = self.state()
                            if self.ready(resumed, capsule):
                                actual = {key: value["consumer_id"] for key, value in resumed["relay"].items()}
                                if actual != consumers:
                                    raise RunFailure("consumer_changed_on_restart")
                                self.result["scenarios"]["resume"] = {"passed": True, "consumers": actual}
                                break
                            time.sleep(min(0.2, self.remaining()))
                        self.result["status"] = "passed"
                        break
                time.sleep(min(0.2, self.remaining()))
        except (RunFailure, ValueError, KeyError, OSError, subprocess.SubprocessError) as error:
            self.result["error"] = str(error) if isinstance(error, RunFailure) else "preflight_or_runtime_failed"
        finally:
            self.stop_children()
            if prepared:
                try:
                    restored = self.invoke("cleanup", timeout=60)
                    self.result["cleanup"] = all(f["deleted"] for f in restored["fixtures"]) and all(f["deleted"] for f in restored.get("derived", []))
                    self.result["derived"] = restored.get("derived", [])
                    self.result["fixtures"] = restored["fixtures"]
                except (RunFailure, ValueError, KeyError, OSError):
                    self.stop_children()
                    if not self.confirm_no_fixture_intent():
                        self.result["cleanup_error"] = "cleanup_unconfirmed_journal_retained"
                finally:
                    self.stop_children()
            if not self.result["cleanup"]:
                self.result["status"] = "failed"
            try:
                self.result["originals_preserved"] = bool(originals) and all(self.test.source(value["checkout"]) == value for value in originals.values())
                if not self.result["originals_preserved"]:
                    self.result["status"] = "failed"
            except (OSError, subprocess.SubprocessError):
                self.result["status"] = "failed"
                self.result["originals_preserved"] = False
            if capsule and not self.args.cleanup_only:
                main = capsule["manifest"]["main_instance"]
                try:
                    intact = self.test.normal_service_running() and self.test.process_started(main["pid"]) == main["started"]
                except (OSError, subprocess.SubprocessError, ValueError):
                    intact = False
                self.result["main_preserved"] = intact
                if not intact:
                    self.result["status"] = "failed"
            self.result["finished_at"] = time.time()
            self.save()
        return 0 if self.result["status"] == "passed" else 1


def main():
    args = parser().parse_args()
    test = module("test-instance")
    test.instance_name(sys.argv[1:])
    if args.openclaw_agent and (os.environ.get("SYMPHONY_OPENCLAW_TEST_DENY") == "1" or
                               args.scenario not in ("po_incoming", "po_handoff", "po_aggregation", "po_followup")):
        raise SystemExit("OpenClaw-Live-Aufruf verlangt ein PO-Szenario außerhalb der Standardgates")
    if args.openclaw_agent and args.scenario == "po_handoff" and not (args.openclaw_knowledge_question or "").strip():
        raise SystemExit("OpenClaw-Abnahme verlangt --openclaw-knowledge-question")
    if not test.NAME.fullmatch(args.test_instance) or not test.NAME.fullmatch(args.run_id) or not 0 < args.timeout <= 3600 or not 0 < args.port <= 65535:
        raise SystemExit("Ungültiger Testname, Lauf, Port oder Timeout")
    args.checkout = test.canonical(args.checkout)
    args.manifest = test.canonical(args.manifest)
    args.result_dir = test.canonical(args.result_dir)
    if args.cleanup_only and not args.resume:
        raise SystemExit("--cleanup-only verlangt --resume")
    if args.cleanup_plan_sha256 and not (args.cleanup_only and args.resume):
        raise SystemExit("--cleanup-plan-sha256 verlangt --resume --cleanup-only")
    if os.environ.get("SYMPHONY_SERVICE_OWNER_PID") != str(os.getpid()):
        module("service-lock").launch([sys.executable, str(Path(__file__).resolve()), *sys.argv[1:]], name=args.test_instance)
    if (args.result_dir / "result.json").exists() and not args.resume:
        raise SystemExit("Lauf existiert bereits; unveränderten Lauf explizit mit --resume wiederaufnehmen")
    if args.resume:
        plan = json.loads((args.result_dir / "plan.json").read_text())
        if (plan.get("run_id") != args.run_id or plan.get("instance") != args.test_instance
                or (not args.cleanup_plan_sha256 and plan.get("source", {}).get("sha") != args.expected_sha)
                or (not args.cleanup_plan_sha256 and plan.get("source", {}).get("source_sha256") != args.expected_source)
                or plan.get("source", {}).get("checkout") != str(args.checkout)
                or plan.get("scenario", "bootstrap") != args.scenario
                or plan.get("yolo", False) != args.yolo
                or plan.get("openclaw_agent") != args.openclaw_agent):
            raise SystemExit("Wiederaufnahme gehört nicht zum bestehenden Lauf; Resultate erhalten")
    signalled = []
    def interrupted(signum, _frame):
        if not signalled:
            signalled.append(signum)
            raise RunFailure("signal_" + str(signum))
    for number in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(number, interrupted)
    status = Run(args).execute()
    print("Testresultat: " + str(args.result_dir / "result.json"))
    return status


if __name__ == "__main__":
    sys.exit(main())
