#!/usr/bin/env bash

sym_watch_stderr() {
  printf 'sym-watch: %s\n' "$*" >&2
}

sym_watch_die() {
  sym_watch_stderr "$@"
  exit 1
}

sym_watch_realpath() {
  command -v python3 >/dev/null 2>&1 || {
    sym_watch_stderr "python3 not found in PATH"
    return 1
  }
  python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "$1"
}

sym_watch_source_repo() {
  local script_source="${BASH_SOURCE[0]}"
  local resolved_source
  local script_dir
  local common_dir

  if [[ "$script_source" != */* ]]; then
    resolved_source="$(command -v -- "$script_source" 2>/dev/null || true)"

    if [[ -n "$resolved_source" ]]; then
      script_source="$resolved_source"
    fi
  fi

  resolved_source="$(sym_watch_realpath "$script_source")" || return 1

  if [[ -n "$resolved_source" ]]; then
    script_source="$resolved_source"
  fi

  script_dir="$(cd "$(dirname "$script_source")" && pwd -P 2>/dev/null)" ||
    sym_watch_die "cannot resolve script directory"

  if [[ -f "$script_dir/WORKFLOW.md" && -f "$script_dir/mix.exs" ]]; then
    printf '%s\n' "$script_dir"
    return
  fi

  common_dir="$(git -C "$script_dir" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"

  if [[ -n "$common_dir" ]]; then
    (
      cd "$common_dir/.." >/dev/null 2>&1 && pwd -P
    )
    return
  fi

  sym_watch_die "cannot determine the Symphony source repository"
}

sym_watch_run_mix() {
  local source_repo="$1"
  local mix_runtime="$source_repo/scripts/mix-runtime"
  shift

  [[ -x "$mix_runtime" ]] || sym_watch_die "Mix-Preflight fehlt oder ist nicht ausführbar: $mix_runtime"
  "$mix_runtime" mix "$source_repo" "$@"
}

sym_watch_run() {
  local source_repo
  local mix_runtime

  if ! source_repo="$(sym_watch_source_repo)"; then
    exit 1
  fi

  mix_runtime="$source_repo/scripts/mix-runtime"
  [[ -x "$mix_runtime" ]] || sym_watch_die "Mix-Preflight fehlt oder ist nicht ausführbar: $mix_runtime"

  (
    cd "$source_repo" || exit 1
    "$mix_runtime" prepare "$source_repo" 1>&2 || exit "$?"
    sym_watch_run_mix "$source_repo" run --no-compile --no-start -e \
      'SymphonyElixir.Codex.Watch.main(System.argv())' -- "$@"
  )
}

sym_watch_run "$@"
