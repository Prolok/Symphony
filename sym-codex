#!/usr/bin/env bash

_sym_codex_sourced=0
if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
  _sym_codex_sourced=1
fi

sym_codex_finish() {
  local status="${1:-0}"

  if (( _sym_codex_sourced )); then
    return "$status"
  fi

  exit "$status"
}

sym_codex_stderr() {
  printf 'sym-codex: %s\n' "$*" >&2
}

sym_codex_usage() {
  cat >&2 <<'EOF'
Usage:
  sym-codex [<issue.identifier>]
  sym-codex --observer [<issue.identifier>]

Direct execution runs Codex in the selected worktree.
If no issue identifier is given from inside a configured worktree, sym-codex reuses that worktree.
If the script is sourced, the current shell stays in that worktree afterwards.
EOF
}

SYM_CODEX_PROMPT=""
SYM_CODEX_WORKFLOW_STEP=""
SYM_CODEX_SESSION_ID=""
SYM_CODEX_MODEL_DEFAULT="gpt-5.6-sol"
SYM_CODEX_REASONING_EFFORT_DEFAULT="high"
SYM_CODEX_SERVICE_TIER_DEFAULT="flex"
SYM_CODEX_HUMAN_SERVICE_TIER_DEFAULT="priority"

sym_codex_die() {
  sym_codex_stderr "$@"
  sym_codex_finish 1
}

sym_codex_activate_venv() {
  local project_root="$1"
  local workspace="$2"
  local source_repo="$3"
  local candidate_root=""
  local activate_script=""

  for candidate_root in "$project_root" "$workspace" "$source_repo"; do
    if [[ -n "$candidate_root" ]]; then
      activate_script="$candidate_root/.venv/bin/activate"

      if [[ -f "$activate_script" ]]; then
        export BASH_ENV="$activate_script"
        export VIRTUAL_ENV_DISABLE_PROMPT=1
        # shellcheck disable=SC1090
        . "$activate_script"
        return 0
      fi
    fi
  done

  return 0
}

sym_codex_realpath() {
  command -v python3 >/dev/null 2>&1 || {
    sym_codex_stderr "python3 not found in PATH"
    return 1
  }
  python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "$1"
}

sym_codex_source_repo() {
  local script_source="${BASH_SOURCE[0]}"
  local resolved_source
  local script_dir
  local common_dir

  if [[ "$script_source" != */* ]]; then
    resolved_source="$(command -v -- "$script_source" 2>/dev/null || true)"

    if [[ -n "$resolved_source" ]]; then
      script_source="$resolved_source"
    fi
  fi

  resolved_source="$(sym_codex_realpath "$script_source")" || return 1

  if [[ -n "$resolved_source" ]]; then
    script_source="$resolved_source"
  fi

  script_dir="$(cd "$(dirname "$script_source")" && pwd -P 2>/dev/null)" ||
    sym_codex_die "cannot resolve script directory"

  if [[ -f "$script_dir/WORKFLOW.md" && -f "$script_dir/mix.exs" ]]; then
    printf '%s\n' "$script_dir"
    return
  fi

  common_dir="$(git -C "$script_dir" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"

  if [[ -n "$common_dir" ]]; then
    (
      cd "$common_dir/.." >/dev/null 2>&1 && pwd -P
    )
    return
  fi

  sym_codex_die "cannot determine the Symphony source repository"
}

sym_codex_run_mix() {
  local source_repo="$1"
  local mix_runtime="$source_repo/scripts/mix-runtime"
  shift

  if [[ "${SYMPHONY_RELEASE_ROOT:-}" == "$source_repo" && "${1:-}" == run ]]; then
    shift
    "$mix_runtime" mix "$source_repo" run --no-compile "$@"
    return "$?"
  fi

  [[ -x "$mix_runtime" ]] || sym_codex_die "Mix-Preflight fehlt oder ist nicht ausführbar: $mix_runtime"
  "$mix_runtime" mix "$source_repo" "$@"
}

sym_codex_prepare_mix() {
  local source_repo="$1"
  local mix_runtime="$source_repo/scripts/mix-runtime"

  if [[ "${SYMPHONY_RELEASE_ROOT:-}" == "$source_repo" ]]; then
    [[ -f "$source_repo/.symphony-release.json" ]] || sym_codex_die "ungebundener Laufzeitstand"
    python3 "$source_repo/scripts/installation-release.py" verify "$source_repo" || sym_codex_die "Laufzeitstand wurde verändert"
    return 0
  fi

  [[ -x "$mix_runtime" ]] || sym_codex_die "Mix-Preflight fehlt oder ist nicht ausführbar: $mix_runtime"
  "$mix_runtime" prepare "$source_repo" 1>&2
}

sym_codex_project_root() {
  local start_dir="$1"
  local common_dir
  local project_root

  if [[ "${SYMPHONY_LINEAR_AUTH_MODE:-}" == app && -n "${SYMPHONY_LINEAR_ENV_DIR:-}" ]]; then
    dirname -- "$SYMPHONY_LINEAR_ENV_DIR"
    return 0
  fi

  common_dir="$(git -C "$start_dir" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"

  if [[ -n "$common_dir" ]]; then
    project_root="$(
      cd "$common_dir/.." >/dev/null 2>&1 && pwd -P
    )" || return 1

    printf '%s\n' "$project_root"
    return 0
  fi

  project_root="$(git -C "$start_dir" rev-parse --path-format=absolute --show-toplevel 2>/dev/null || true)"

  if [[ -n "$project_root" ]]; then
    printf '%s\n' "$project_root"
    return 0
  fi

  (
    cd "$start_dir" >/dev/null 2>&1 && pwd -P
  )
}

sym_codex_workspace_root() {
  local source_repo="$1"
  local workflow_file="$2"
  local project_root="$3"

  if [[ -n "${SYMPHONY_PROJECT_WORKTREES_ROOT:-}" ]]; then
    printf '%s\n' "$SYMPHONY_PROJECT_WORKTREES_ROOT"
    return
  fi

  (
    cd "$source_repo" || exit 1
    export SYMPHONY_PROJECT_ROOT="$project_root"
    export SYMPHONY_PROJECT_WORKTREES_ROOT="${project_root}-worktrees"
    sym_codex_prepare_mix "$source_repo"
    sym_codex_run_mix "$source_repo" run --no-compile --no-start -e '
      workflow_path = Enum.at(System.argv(), 0) || raise "missing workflow file"
      env_files_dir = System.get_env("SYMPHONY_PROJECT_ROOT") || File.cwd!()

      case SymphonyElixir.Codex.ScriptSupport.workspace_root(workflow_path, env_files_dir) do
        {:ok, workspace_root} ->
          IO.write(workspace_root)

        {:error, reason} ->
          raise "workspace_root_error: #{inspect(reason)}"
      end
    ' -- "$workflow_file"
  )
}

sym_codex_build_manual_prompt() {
  local source_repo="$1"
  local workflow_file="$2"
  local interactive_workflow_file="$3"
  local dialog_workflow_file="$4"
  local project_root="$5"
  local issue_identifier="$6"
  local workspace="$7"

  (
    cd "$source_repo" || exit 1
    export SYMPHONY_ACTIVE_REPO_ROOT="$workspace"
    export SYMPHONY_PROJECT_ROOT="$project_root"
    export SYMPHONY_PROJECT_WORKTREES_ROOT="${project_root}-worktrees"
    export SYMPHONY_SOURCE_REPO="$source_repo"
    export SYMPHONY_WORKFLOW_FILE="$workflow_file"
    export SYMPHONY_WORKFLOW_DIR
    SYMPHONY_WORKFLOW_DIR="$(cd "$(dirname "$workflow_file")" >/dev/null 2>&1 && pwd -P)"
    sym_codex_prepare_mix "$source_repo"
    sym_codex_run_mix "$source_repo" run --no-compile --no-start -e '
      workflow_path = Enum.at(System.argv(), 0) || raise "missing workflow file"
      interactive_workflow_path = Enum.at(System.argv(), 1) || raise "missing interactive workflow file"
      dialog_workflow_path = Enum.at(System.argv(), 2) || raise "missing dialog workflow file"
      issue_identifier = Enum.at(System.argv(), 3) || raise "missing issue identifier"
      env_files_dir = System.get_env("SYMPHONY_PROJECT_ROOT") || File.cwd!()

      case SymphonyElixir.Codex.ScriptSupport.manual_prompt_context(
             workflow_path,
             interactive_workflow_path,
             dialog_workflow_path,
             issue_identifier,
             env_files_dir
           ) do
        {:ok, %{prompt: prompt, workflow_step: workflow_step, session_id: session_id}} ->
          runtime_env = SymphonyElixir.Linear.WriteContext.with_context(
            %{run_id: Ecto.UUID.generate(), phase: workflow_step},
            &SymphonyElixir.Config.linear_runtime_env/0
          )
          if runtime_env == %{} do
            IO.write("SYM_CODEX_CONTEXT_V2\n")
          else
            IO.write("SYM_CODEX_CONTEXT_V3\n" <> Jason.encode!(runtime_env) <> "\n")
          end
          IO.write((workflow_step || "") <> "\n")
          IO.write((session_id || "") <> "\n")
          IO.write("SYM_CODEX_PROMPT_V1\n")
          IO.write(prompt)

        {:error, reason} ->
          raise "manual_prompt_error: #{inspect(reason)}"
      end
    ' -- "$workflow_file" "$interactive_workflow_file" "$dialog_workflow_file" "$issue_identifier"
  )
}

sym_codex_issue_workflow_step() {
  local source_repo="$1"
  local workflow_file="$2"
  local project_root="$3"
  local issue_identifier="$4"

  (
    cd "$source_repo" || exit 1
    export SYMPHONY_PROJECT_ROOT="$project_root"
    export SYMPHONY_PROJECT_WORKTREES_ROOT="${project_root}-worktrees"
    export SYMPHONY_SOURCE_REPO="$source_repo"
    export SYMPHONY_WORKFLOW_FILE="$workflow_file"
    sym_codex_prepare_mix "$source_repo"
    sym_codex_run_mix "$source_repo" run --no-compile --no-start -e '
      workflow_path = Enum.at(System.argv(), 0) || raise "missing workflow file"
      issue_identifier = Enum.at(System.argv(), 1) || raise "missing issue identifier"
      env_files_dir = System.get_env("SYMPHONY_PROJECT_ROOT") || File.cwd!()

      case SymphonyElixir.Codex.ScriptSupport.workflow_step(workflow_path, issue_identifier, env_files_dir) do
        {:ok, workflow_step} ->
          IO.write(workflow_step || "")

        {:error, reason} ->
          raise "workflow_step_error: #{inspect(reason)}"
      end
    ' -- "$workflow_file" "$issue_identifier"
  )
}

sym_codex_resolve_dialog_workspace() {
  local source_repo="$1"
  local workflow_file="$2"
  local project_root="$3"
  local issue_identifier="$4"

  (
    cd "$source_repo" || exit 1
    export SYMPHONY_PROJECT_ROOT="$project_root"
    export SYMPHONY_PROJECT_WORKTREES_ROOT="${project_root}-worktrees"
    export SYMPHONY_SOURCE_REPO="$source_repo"
    export SYMPHONY_WORKFLOW_FILE="$workflow_file"
    sym_codex_prepare_mix "$source_repo"
    sym_codex_run_mix "$source_repo" run --no-compile --no-start -e '
      workflow_path = Enum.at(System.argv(), 0) || raise "missing workflow file"
      issue_identifier = Enum.at(System.argv(), 1) || raise "missing issue identifier"
      env_files_dir = System.get_env("SYMPHONY_PROJECT_ROOT") || File.cwd!()

      case SymphonyElixir.Codex.ScriptSupport.dialog_workspace(workflow_path, issue_identifier, env_files_dir) do
        {:ok, workspace} ->
          IO.write(workspace)

        {:error, reason} ->
          raise "dialog_workspace_error: #{inspect(reason)}"
      end
    ' -- "$workflow_file" "$issue_identifier"
  )
}

sym_codex_parse_manual_prompt_context() {
  local prompt_context="$1"
  local context_v1_prefix=$'SYM_CODEX_CONTEXT_V1\n'
  local context_v2_prefix=$'SYM_CODEX_CONTEXT_V2\n'
  local context_v3_prefix=$'SYM_CODEX_CONTEXT_V3\n'
  local prompt_marker=$'\nSYM_CODEX_PROMPT_V1\n'
  local terminal_prompt_marker=$'\nSYM_CODEX_PROMPT_V1'
  local metadata=""
  local remainder=""
  local newline=$'\n'

  if [[ "$prompt_context" == "$context_v3_prefix"* ]]; then
    remainder="${prompt_context#"$context_v3_prefix"}"
    local runtime_json="${remainder%%"$newline"*}"
    local runtime_entries name value
    runtime_entries="$(python3 -c '
import json,sys
data=json.loads(sys.argv[1])
allowed={"SYMPHONY_LINEAR_AUTH_MODE","SYMPHONY_LINEAR_CLIENT_SECRET_ENV","SYMPHONY_LINEAR_BINDING_HASH","SYMPHONY_CODEX_STATE_ROOT","SYMPHONY_RUN_ID","SYMPHONY_PHASE"}
assert set(data) == allowed and data["SYMPHONY_LINEAR_AUTH_MODE"] == "app"
for key,value in data.items():
    assert isinstance(value,str) and "\n" not in value and "\r" not in value
    print(key+"="+value)
' "$runtime_json")" || sym_codex_die "invalid app runtime context"
    while IFS='=' read -r name value; do
      export "$name=$value"
    done <<< "$runtime_entries"
    prompt_context="$context_v2_prefix${remainder#*"$newline"}"
  fi

  if [[ "$prompt_context" == "$context_v2_prefix"* ]] && [[ "$prompt_context" == *"$prompt_marker"* ]]; then
    remainder="${prompt_context#"$context_v2_prefix"}"
    metadata="${remainder%%"$prompt_marker"*}"
    SYM_CODEX_PROMPT="${remainder#*"$prompt_marker"}"
    SYM_CODEX_WORKFLOW_STEP="${metadata%%"$newline"*}"

    if [[ "$metadata" == *"$newline"* ]]; then
      SYM_CODEX_SESSION_ID="${metadata#*"$newline"}"
    else
      SYM_CODEX_SESSION_ID=""
    fi

    return 0
  fi

  if [[ "$prompt_context" == "$context_v2_prefix"* ]] && [[ "$prompt_context" == *"$terminal_prompt_marker" ]]; then
    remainder="${prompt_context#"$context_v2_prefix"}"
    metadata="${remainder%%"$terminal_prompt_marker"*}"
    SYM_CODEX_PROMPT=""
    SYM_CODEX_WORKFLOW_STEP="${metadata%%"$newline"*}"

    if [[ "$metadata" == *"$newline"* ]]; then
      SYM_CODEX_SESSION_ID="${metadata#*"$newline"}"
    else
      SYM_CODEX_SESSION_ID=""
    fi

    return 0
  fi

  if [[ "$prompt_context" == "$context_v1_prefix"* ]] && [[ "$prompt_context" == *"$prompt_marker"* ]]; then
    remainder="${prompt_context#"$context_v1_prefix"}"
    SYM_CODEX_WORKFLOW_STEP="${remainder%%"$prompt_marker"*}"
    SYM_CODEX_SESSION_ID=""
    SYM_CODEX_PROMPT="${remainder#*"$prompt_marker"}"
    return 0
  fi

  if [[ "$prompt_context" == "$context_v1_prefix"* ]] && [[ "$prompt_context" == *"$terminal_prompt_marker" ]]; then
    remainder="${prompt_context#"$context_v1_prefix"}"
    SYM_CODEX_WORKFLOW_STEP="${remainder%%"$terminal_prompt_marker"*}"
    SYM_CODEX_SESSION_ID=""
    SYM_CODEX_PROMPT=""
    return 0
  fi

  SYM_CODEX_WORKFLOW_STEP=""
  SYM_CODEX_SESSION_ID=""
  SYM_CODEX_PROMPT="$prompt_context"
}

sym_codex_trim() {
  local value="$1"

  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"

  printf '%s\n' "$value"
}

sym_codex_unquote_env_value() {
  local value="$1"

  case "$value" in
    \"*\")
      value="${value#\"}"
      value="${value%\"}"
      ;;
    \'*\')
      value="${value#\'}"
      value="${value%\'}"
      ;;
  esac

  printf '%s\n' "$value"
}

sym_codex_apply_launch_env_file() {
  local env_path="$1"
  local keep_model="$2"
  local keep_reasoning="$3"
  local keep_service_tier="$4"
  local keep_human_service_tier="$5"
  local line
  local assignment
  local key
  local value

  [[ -f "$env_path" ]] || return 0

  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%$'\r'}"
    line="$(sym_codex_trim "$line")"

    [[ -z "$line" || "$line" == \#* ]] && continue

    if [[ "$line" == export[[:space:]]* ]]; then
      line="$(sym_codex_trim "${line#export}")"
    fi

    [[ "$line" == *=* ]] || continue

    key="$(sym_codex_trim "${line%%=*}")"
    # Discard all other values before passing anything to helper subprocesses.
    case "$key" in
      SYM_CODEX_MODEL|SYM_CODEX_REASONING_EFFORT|SYM_CODEX_SERVICE_TIER|SYM_CODEX_HUMAN_SERVICE_TIER) ;;
      *) continue ;;
    esac
    value="${line#*=}"
    value="${value%%#*}"
    value="$(sym_codex_trim "$value")"
    value="$(sym_codex_unquote_env_value "$value")"
    assignment="$key=$value"

    case "$key" in
      SYM_CODEX_MODEL)
        if [[ "$keep_model" != "1" ]]; then
          export "$assignment"
        fi
        ;;
      SYM_CODEX_REASONING_EFFORT)
        if [[ "$keep_reasoning" != "1" ]]; then
          export "$assignment"
        fi
        ;;
      SYM_CODEX_SERVICE_TIER)
        if [[ "$keep_service_tier" != "1" ]]; then
          export "$assignment"
        fi
        ;;
      SYM_CODEX_HUMAN_SERVICE_TIER)
        if [[ "$keep_human_service_tier" != "1" ]]; then
          export "$assignment"
        fi
        ;;
    esac
  done <"$env_path"
}

sym_codex_load_launch_env() {
  local project_root="$1"
  local keep_model=0
  local keep_reasoning=0
  local keep_service_tier=0
  local keep_human_service_tier=0

  [[ -n "${SYM_CODEX_MODEL+x}" ]] && keep_model=1
  [[ -n "${SYM_CODEX_REASONING_EFFORT+x}" ]] && keep_reasoning=1
  [[ -n "${SYM_CODEX_SERVICE_TIER+x}" ]] && keep_service_tier=1
  [[ -n "${SYM_CODEX_HUMAN_SERVICE_TIER+x}" ]] && keep_human_service_tier=1

  if [[ -f "$project_root/.symphony/root-config.json" ]]; then
    local entries key value
    entries="$(python3 - "$project_root/.symphony/root-config.json" <<'PY'
import json, os, sys
values = json.load(open(sys.argv[1]))['values']
for name in ('SYM_CODEX_MODEL', 'SYM_CODEX_REASONING_EFFORT', 'SYM_CODEX_SERVICE_TIER', 'SYM_CODEX_HUMAN_SERVICE_TIER'):
    if name in values and name not in os.environ:
        value = values[name]
        assert isinstance(value, str) and '\n' not in value and '\r' not in value
        print(name + '=' + value)
PY
)" || return 1
    while IFS='=' read -r key value; do
      [[ -z "$key" ]] || export "$key=$value"
    done <<< "$entries"
    return 0
  fi

  sym_codex_apply_launch_env_file "$project_root/.env" "$keep_model" "$keep_reasoning" "$keep_service_tier" "$keep_human_service_tier"
  sym_codex_apply_launch_env_file "$project_root/.env.local" "$keep_model" "$keep_reasoning" "$keep_service_tier" "$keep_human_service_tier"
}

sym_codex_set_launch_profile() {
  local _workflow_step="$1"

  : "${SYM_CODEX_MODEL:=$SYM_CODEX_MODEL_DEFAULT}"
  : "${SYM_CODEX_REASONING_EFFORT:=$SYM_CODEX_REASONING_EFFORT_DEFAULT}"
  : "${SYM_CODEX_SERVICE_TIER:=$SYM_CODEX_SERVICE_TIER_DEFAULT}"
  : "${SYM_CODEX_HUMAN_SERVICE_TIER:=$SYM_CODEX_HUMAN_SERVICE_TIER_DEFAULT}"
}

sym_codex_effective_service_tier() {
  local observer_mode="$1"

  if [[ "$observer_mode" == "1" ]]; then
    printf '%s\n' "$SYM_CODEX_SERVICE_TIER"
  else
    printf '%s\n' "$SYM_CODEX_HUMAN_SERVICE_TIER"
  fi
}

sym_codex_expand_path() {
  local project_root="$1"
  local raw_path="$2"

  case "$raw_path" in
    "~")
      printf '%s\n' "$HOME"
      ;;
    "~/"*)
      printf '%s\n' "$HOME/${raw_path#~/}"
      ;;
    /*)
      printf '%s\n' "$raw_path"
      ;;
    *)
      printf '%s\n' "$project_root/$raw_path"
      ;;
  esac
}

sym_codex_safe_identifier() {
  LC_ALL=C sed 's/[^A-Za-z0-9._-]/_/g' <<<"$1"
}

sym_codex_toml_basic_string() {
  local value="$1"

  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  value="${value//$'\n'/\\n}"
  value="${value//$'\r'/\\r}"
  value="${value//$'\t'/\\t}"

  printf '"%s"' "$value"
}

sym_codex_infer_issue_identifier_from_cwd() {
  local source_repo="$1"
  local workflow_file="$2"
  local project_root="$3"
  local workspace_root
  local current_dir
  local relative_path
  local issue_identifier

  workspace_root="$(sym_codex_workspace_root "$source_repo" "$workflow_file" "$project_root")" || return 1
  workspace_root="$(sym_codex_expand_path "$project_root" "$workspace_root")"
  current_dir="$(pwd -P)"

  case "$current_dir" in
    "$workspace_root"/*)
      relative_path="${current_dir#"$workspace_root"/}"

      case "$relative_path" in
        .dialog/*)
          issue_identifier="${relative_path#".dialog/"}"
          issue_identifier="${issue_identifier%%/*}"
          ;;
        *)
          issue_identifier="${relative_path%%/*}"
          ;;
      esac

      if [[ -n "$issue_identifier" ]]; then
        printf '%s\n' "$issue_identifier"
        return 0
      fi
      ;;
  esac

  return 1
}

sym_codex_current_workspace_for_issue() {
  local issue_identifier="$1"
  local expected_branch="symphony/$issue_identifier"
  local current_dir
  local branch_name
  local workspace_root

  current_dir="$(pwd -P)"

  if ! git -C "$current_dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    return 1
  fi

  branch_name="$(git -C "$current_dir" branch --show-current 2>/dev/null || true)"

  if [[ "$branch_name" != "$expected_branch" ]]; then
    return 1
  fi

  workspace_root="$(git -C "$current_dir" rev-parse --path-format=absolute --show-toplevel 2>/dev/null || true)"

  if [[ -z "$workspace_root" ]]; then
    return 1
  fi

  printf '%s\n' "$workspace_root"
}

sym_codex_infer_issue_identifier_from_branch() {
  local current_dir
  local branch_name
  local issue_identifier

  current_dir="$(pwd -P)"

  if ! git -C "$current_dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    return 1
  fi

  branch_name="$(git -C "$current_dir" branch --show-current 2>/dev/null || true)"

  case "$branch_name" in
    symphony/*)
      issue_identifier="${branch_name#symphony/}"

      if [[ -n "$issue_identifier" ]]; then
        printf '%s\n' "$issue_identifier"
        return 0
      fi
      ;;
  esac

  return 1
}

sym_codex_resolve_workspace() {
  local source_repo="$1"
  local workflow_file="$2"
  local project_root="$3"
  local issue_identifier="$4"
  local workspace_root
  local safe_identifier
  local workspace
  local branch_name
  local expected_branch="symphony/$issue_identifier"

  workspace_root="$(sym_codex_workspace_root "$source_repo" "$workflow_file" "$project_root")" ||
    sym_codex_die "cannot resolve workspace root from $workflow_file"
  workspace_root="$(sym_codex_expand_path "$project_root" "$workspace_root")"

  safe_identifier="$(sym_codex_safe_identifier "$issue_identifier")"
  workspace="$workspace_root/$safe_identifier"

  if ! git -C "$workspace" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    sym_codex_die "no existing worktree for $issue_identifier at $workspace"
  fi

  branch_name="$(git -C "$workspace" branch --show-current 2>/dev/null || true)"

  if [[ "$branch_name" != "$expected_branch" ]]; then
    sym_codex_die "worktree $workspace is on branch ${branch_name:-<unknown>}, expected $expected_branch"
  fi

  printf '%s\n' "$workspace"
}

sym_codex_run() {
  local original_args=("$@")
  local observer_mode=0
  local issue_identifier_inferred=0
  local issue_identifier=""
  local source_repo
  local project_root
  local workflow_file
  local interactive_workflow_file
  local dialog_workflow_file
  local workspace=""
  local prompt_context=""
  local prompt=""
  local workflow_step=""
  local service_tier=""
  local -a codex_args=(--config shell_environment_policy.inherit=all)

  while (($# > 0)); do
    case "$1" in
      --observer|--app-server|--ubserver)
        observer_mode=1
        ;;
      -h|--help)
        sym_codex_usage
        sym_codex_finish 0
        ;;
      --)
        shift
        break
        ;;
      -*)
        sym_codex_die "unknown option: $1"
        ;;
      *)
        if [[ -n "$issue_identifier" ]]; then
          sym_codex_die "expected at most one issue identifier"
        fi

        issue_identifier="$1"
        ;;
    esac

    shift
  done

  if (($# > 0)); then
    sym_codex_die "unexpected positional arguments: $*"
  fi

  if ! source_repo="$(sym_codex_source_repo)"; then
    sym_codex_finish 1
  fi

  if [[ -z "${SYMPHONY_RELEASE_ROOT:-}" && ! -f "$source_repo/.symphony-release.json" &&
        -f "$source_repo/scripts/installation-release.py" ]] &&
      python3 "$source_repo/scripts/installation-release.py" app-workflow "$source_repo"; then
    python3 "$source_repo/scripts/installation-release.py" codex "$source_repo" sym-codex "${original_args[@]}"
    return "$?"
  fi

  if [[ -f "$source_repo/.symphony/root-config.json" ]]; then
    export SYMPHONY_RELEASE_ROOT="$source_repo"
    export SYMPHONY_ROOT_DIR="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["root"])' "$source_repo/.symphony/root-config.json")"
  elif [[ -z "${SYMPHONY_ROOT_DIR:-}" ]]; then
    export SYMPHONY_ROOT_DIR="$source_repo"
  fi

  if ! project_root="$(sym_codex_project_root "$(pwd -P)")"; then
    sym_codex_die "cannot determine the local project root"
  fi

  workflow_file="$source_repo/WORKFLOW.md"
  interactive_workflow_file="$source_repo/WORKFLOW_INTERACTIVE.md"
  dialog_workflow_file="$source_repo/WORKFLOW_DIALOG.md"
  if [[ "${SYMPHONY_RELEASE_ROOT:-}" == "$source_repo" ]]; then
    workflow_file="${SYMPHONY_WORKFLOW_FILE:-$workflow_file}"
    interactive_workflow_file="${SYMPHONY_WORKFLOW_INTERACTIVE_FILE:-$interactive_workflow_file}"
    dialog_workflow_file="${SYMPHONY_WORKFLOW_DIALOG_FILE:-$dialog_workflow_file}"
  fi

  if [[ -z "$issue_identifier" ]]; then
    issue_identifier="$(sym_codex_infer_issue_identifier_from_branch 2>/dev/null || true)"

    if [[ -n "$issue_identifier" ]]; then
      issue_identifier_inferred=1
    else
      issue_identifier="$(sym_codex_infer_issue_identifier_from_cwd "$source_repo" "$workflow_file" "$project_root" 2>/dev/null || true)"

      if [[ -n "$issue_identifier" ]]; then
        issue_identifier_inferred=1
      fi
    fi
  fi

  if [[ -n "$issue_identifier" ]]; then
    if (( observer_mode )); then
      if (( issue_identifier_inferred )); then
        workspace="$(sym_codex_current_workspace_for_issue "$issue_identifier" 2>/dev/null || true)"
      fi
    else
      workflow_step="$(sym_codex_issue_workflow_step "$source_repo" "$workflow_file" "$project_root" "$issue_identifier")" ||
        sym_codex_die "cannot resolve workflow step for $issue_identifier"
    fi

    if [[ "$workflow_step" == "Todo (Dialog-AI)" ]]; then
      workspace="$(sym_codex_resolve_dialog_workspace "$source_repo" "$workflow_file" "$project_root" "$issue_identifier")" ||
        sym_codex_finish 1
    elif (( issue_identifier_inferred )) && [[ -z "$workspace" ]]; then
      workspace="$(sym_codex_current_workspace_for_issue "$issue_identifier" 2>/dev/null || true)"
    fi

    if [[ -z "$workspace" ]] &&
         ! workspace="$(sym_codex_resolve_workspace "$source_repo" "$workflow_file" "$project_root" "$issue_identifier")"; then
      sym_codex_finish 1
    fi

    if (( ! issue_identifier_inferred )) || [[ "$workflow_step" == "Todo (Dialog-AI)" ]]; then
      cd "$workspace" || sym_codex_die "cannot change into $workspace"
    fi
  elif (( ! observer_mode )); then
    sym_codex_usage
    sym_codex_finish 1
  fi

  if (( ! observer_mode )); then
    prompt_context="$(sym_codex_build_manual_prompt "$source_repo" "$workflow_file" "$interactive_workflow_file" "$dialog_workflow_file" "$project_root" "$issue_identifier" "$workspace")" ||
      sym_codex_die "cannot build prompt for $issue_identifier"
    sym_codex_parse_manual_prompt_context "$prompt_context"
    prompt="$SYM_CODEX_PROMPT"
    workflow_step="$SYM_CODEX_WORKFLOW_STEP"
  fi

  sym_codex_load_launch_env "$source_repo"
  if (( observer_mode )) && [[ "${SYMPHONY_RELEASE_ROOT:-}" == "$source_repo" ]] && [[ -z "${SYMPHONY_LINEAR_AUTH_MODE:-}" ]]; then
    # A directly invoked observer must derive app mode from its workflow too.
    prompt_context="$(
      sym_codex_prepare_mix "$source_repo" &&
      sym_codex_run_mix "$source_repo" run --no-start -e '
        [workflow, project] = System.argv()
        :ok = SymphonyElixir.Workflow.set_workflow_file_path(workflow)
        :ok = SymphonyElixir.EnvFile.load_runtime(SymphonyElixir.EnvFile.config_dir(project))
        runtime_env = SymphonyElixir.Config.linear_runtime_env()
        if runtime_env != %{}, do: IO.write("SYM_CODEX_CONTEXT_V3\n" <> Jason.encode!(runtime_env) <> "\n\n\nSYM_CODEX_PROMPT_V1\n")
      ' -- "$workflow_file" "$project_root"
    )" || sym_codex_die "cannot bind observer runtime context"
    if [[ -n "$prompt_context" ]]; then
      sym_codex_parse_manual_prompt_context "$prompt_context"
    fi
  fi
  sym_codex_set_launch_profile "$workflow_step"
  service_tier="$(sym_codex_effective_service_tier "$observer_mode")"

  if [[ -n "$service_tier" ]]; then
    codex_args+=(--config "service_tier=$service_tier")
  fi

  if [[ -n "$SYM_CODEX_REASONING_EFFORT" ]]; then
    codex_args+=(--config "model_reasoning_effort=$SYM_CODEX_REASONING_EFFORT")
  fi

  if [[ -n "$SYM_CODEX_MODEL" ]]; then
    codex_args+=(--model "$SYM_CODEX_MODEL")
  fi

  if (( observer_mode )); then
    codex_args+=(app-server)
  else
    export SYMPHONY_ACTIVE_REPO_ROOT="$workspace"
    export SYMPHONY_PROJECT_ROOT="$project_root"
    export SYMPHONY_SOURCE_REPO="$project_root"
    export SYMPHONY_WORKFLOW_DIR="$source_repo"
    export SYMPHONY_WORKFLOW_FILE="$workflow_file"
    export SYMPHONY_WORKFLOW_INTERACTIVE_FILE="$interactive_workflow_file"
    export SYMPHONY_WORKFLOW_DIALOG_FILE="$dialog_workflow_file"
    export SYMPHONY_ISSUE_IDENTIFIER="$issue_identifier"
    unset SYMPHONY_ISSUE_ID SYMPHONY_ISSUE_LABELS_JSON

    codex_args+=(
      --config "mcp_servers.symphony_linear.command=$(sym_codex_toml_basic_string "$source_repo/sym-codex-mcp")"
      --config "mcp_servers.symphony_linear.env={SYMPHONY_SOURCE_REPO=$(sym_codex_toml_basic_string "$source_repo"),SYMPHONY_PROJECT_ROOT=$(sym_codex_toml_basic_string "$project_root"),SYMPHONY_WORKFLOW_FILE=$(sym_codex_toml_basic_string "$workflow_file")}"
    )

    if [[ "$workflow_step" == "Todo (Dialog-AI)" && -n "$SYM_CODEX_SESSION_ID" ]]; then
      codex_args+=(resume "$SYM_CODEX_SESSION_ID")

      if [[ -n "$prompt" ]]; then
        codex_args+=("$prompt")
      fi
    else
      codex_args+=("$prompt")
    fi
  fi

  if (( _sym_codex_sourced )); then
    sym_codex_activate_venv "$project_root" "$workspace" "$source_repo"
    (
      unset MIX_DEPS_PATH MIX_BUILD_ROOT MIX_BUILD_PATH
      if [[ "${SYMPHONY_LINEAR_AUTH_MODE:-}" == app ]]; then
        python3 "$source_repo/scripts/codex-app-context.py" "${codex_args[@]}"
      else
        codex "${codex_args[@]}"
      fi
    )
    return $?
  fi

  sym_codex_activate_venv "$project_root" "$workspace" "$source_repo"
  if [[ "${SYMPHONY_LINEAR_AUTH_MODE:-}" == app ]]; then
    exec env -u MIX_DEPS_PATH -u MIX_BUILD_ROOT -u MIX_BUILD_PATH python3 "$source_repo/scripts/codex-app-context.py" "${codex_args[@]}"
  fi

  exec env -u MIX_DEPS_PATH -u MIX_BUILD_ROOT -u MIX_BUILD_PATH codex "${codex_args[@]}"
}

sym_codex_run "$@"
