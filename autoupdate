#!/usr/bin/env bash
set -euo pipefail

unset MIX_DEPS_PATH MIX_BUILD_ROOT MIX_BUILD_PATH

PROJECT_DIR="${1:-}"

if [ -z "$PROJECT_DIR" ]; then
  command -v python3 >/dev/null 2>&1 || { echo "autoupdate: python3 not found in PATH" >&2; exit 127; }
  SCRIPT_PATH="$(python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "${BASH_SOURCE[0]}")"
  PROJECT_DIR="$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)"
else
  PROJECT_DIR="$(cd -- "$PROJECT_DIR" && pwd)"
fi

if [[ -f "$PROJECT_DIR/.symphony-release.json" ]]; then
  echo "symphony: Gebundener Laufzeitstand bleibt unverändert; Update über einen neuen Start durchführen." >&2
  exit 0
fi

if ! command -v git >/dev/null 2>&1; then
  exit 0
fi

if ! git -C "$PROJECT_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  exit 0
fi

if [ -n "$(git -C "$PROJECT_DIR" status --porcelain --untracked-files=normal)" ]; then
  echo "symphony: Autoupdate übersprungen, weil der Checkout lokale Änderungen enthält." >&2
  exit 0
fi

UPSTREAM_REF="$(git -C "$PROJECT_DIR" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)"

if [ -z "$UPSTREAM_REF" ]; then
  exit 0
fi

REMOTE_NAME="${UPSTREAM_REF%%/*}"
REMOTE_BRANCH="${UPSTREAM_REF#*/}"

if [ -z "$REMOTE_NAME" ] || [ "$REMOTE_NAME" = "$UPSTREAM_REF" ] || [ -z "$REMOTE_BRANCH" ]; then
  exit 0
fi

if ! git -C "$PROJECT_DIR" fetch --quiet "$REMOTE_NAME" "$REMOTE_BRANCH"; then
  echo "symphony: Autoupdate konnte den Git-Remote nicht prüfen." >&2
  exit 0
fi

FETCHED_REF="FETCH_HEAD"

if ! git -C "$PROJECT_DIR" merge-base --is-ancestor HEAD "$FETCHED_REF"; then
  echo "symphony: Autoupdate übersprungen, weil der Checkout nicht per Fast-Forward aktualisierbar ist." >&2
  exit 0
fi

AVAILABLE_COMMITS="$(git -C "$PROJECT_DIR" rev-list --count "HEAD..$FETCHED_REF")"

if [ "$AVAILABLE_COMMITS" = "0" ]; then
  exit 0
fi

printf "Neue Symphony Version verfügbar. Update ausführen j/n?"

if ! IFS= read -r ANSWER; then
  exit 0
fi

case "$ANSWER" in
  [jJ] | [jJ][aA] | [yY] | [yY][eE][sS])
    ;;
  *)
    exit 0
    ;;
esac

run_update() {
  cd "$PROJECT_DIR"
  if [[ "${SYMPHONY_RELEASE_ROOT:-}" != "$PROJECT_DIR" ]]; then
    echo "symphony: Update benötigt einen getrennten Laufzeitstand; Symphony für diesen Checkout neu starten." >&2
    return 0
  fi
  # The full development gate covers App mode as well as Legacy. A Legacy
  # runtime may still start on 3.10, but cannot validate an update on it.
  if ! python3 -c 'import sys; sys.exit(sys.version_info < (3, 11))'; then
    echo "symphony: Update nicht ausgeführt: make all benötigt Python 3.11+. Der vorhandene Legacy-Stand wird gestartet." >&2
    return 0
  fi
  git pull --ff-only "$REMOTE_NAME" "$REMOTE_BRANCH"
  # A fast-forward can change the configured toolchain. Validate it before
  # make all, without relying on the runtime inherited from the old revision.
  source "$PROJECT_DIR/scripts/mix-runtime"
  mix_runtime_activate "$PROJECT_DIR"
  make all
}

echo "Symphony Update läuft…"
run_update
