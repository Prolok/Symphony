# Shared Symphony defaults for this repo.
#
# Load order:
# 1. this .env file
# 2. .env.local
# These values override inherited process environment at runtime so each
# project can use its own Linear workspace credentials.
#
# Keep only non-secret shared defaults here.
# Local machine-specific overrides belong in .env.local.
#
# Der gemeinsame WORKFLOW.md verwendet auth_mode: app.
# Öffentliche App-/Projektbindung hier versionieren; keine Workflowkopie.
# Secret, persönlicher Assignee und lokale Overrides
# gehören ausschließlich in die private .symphony/.env.local.
# - LINEAR_APP_CLIENT_ID: OAuth2 Client-ID
# - LINEAR_APP_WORKSPACE_ID: erwartete Organisations-ID
# - LINEAR_APP_USER_ID: erwartete App-User-ID
# - LINEAR_APP_INSTALLATION_ID: feste Projektkennung, keine Ticket-/Rechner-ID
# Zustand wird fest unter .symphony/state des gebundenen Fachprojekts abgelegt.
# - LINEAR_APP_SECRET: Client-Secret, nur in der privaten .env.local setzen
# Ein leeres Secret ist nicht startbereit. Keine zusätzliche Auswahlvariable nötig.
# LINEAR_API_KEY wird nur für alte Workflows oder explizites auth_mode: legacy benötigt.
# Weiterhin erforderlich:
# - exactly one Linear scope:
#   - LINEAR_PROJECT_SLUG: Linear project slug from the project URL
#   - LINEAR_TEAM_KEY: Linear team key
# - LINEAR_TEST_PROJECT_SLUG: Linear test project slug for generated worktrees
# - LINEAR_ASSIGNEE: vorhandene menschliche E-Mail oder UUID beibehalten;
#   literales me vor App-Betrieb kontrolliert unter bisheriger Identität auflösen.
#
# Symphony provides these path variables automatically at runtime.
# Do not set them manually in .env:
# - SYMPHONY_PROJECT_ROOT
# - SYMPHONY_PROJECT_WORKTREES_ROOT
# - SYMPHONY_WORKFLOW_DIR
# - SYMPHONY_WORKFLOW_FILE

LINEAR_PROJECT_SLUG="symphony-07f513c4ae64"
LINEAR_TEAM_KEY=""
LINEAR_TEST_PROJECT_SLUG="symphony-test-7d8cc05658e6"

# Öffentliche projektbezogene Bindung; vom Betreiber ergänzen.
LINEAR_APP_CLIENT_ID=6702c6033848d23e7242f87a769b9899
LINEAR_APP_WORKSPACE_ID=e6d9e421-6a26-488e-9d30-51eca3e92bd4
LINEAR_APP_USER_ID=39185f07-b1d5-479e-bb83-9bca031231f3
LINEAR_APP_INSTALLATION_ID=symphony

# Nur in .symphony/.env.local ergänzen:
# LINEAR_APP_SECRET=
# LINEAR_ASSIGNEE=
